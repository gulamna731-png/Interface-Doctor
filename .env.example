# Server-side only — never expose these to the browser.
# Add real values in the workspace Secrets panel; do NOT commit a .env file.
# After adding or changing a secret, restart the dev server so Next.js loads it.

# Choose the AI engine. Supported values: "demo" (default, self-contained heuristic
# provider, no key required), "ollama" (local, no API key), or "openai".
AI_PROVIDER=demo

# Base URL for the local Ollama service. In GitHub Codespaces this refers to
# the Codespace/container environment, not your personal computer.
OLLAMA_BASE_URL=http://localhost:11434

# Model used for both screenshot diagnosis and redesign.
# For Ollama, it must be installed and support image inputs (e.g. gemma3, llava, llama3.2-vision).
# For OpenAI, use a vision-capable model such as gpt-4o-mini (default), gpt-4o, or gpt-4-turbo.
AI_VISION_MODEL=gemma3

# Required only when AI_PROVIDER=openai. Optional for Ollama.
OPENAI_API_KEY=
